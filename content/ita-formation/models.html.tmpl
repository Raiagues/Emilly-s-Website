<div class="fm-s50"><button aria-label="{{text.t137}}" class="vbtn3 fm-s51" data-control="zoomIn" type="button">+</button><button aria-label="{{text.t138}}" class="vbtn3 fm-s51" data-control="zoomOut" type="button">−</button></div>
<div class="fm-s52"><sc-for as="v" list="{{views}}"><button class="vbtn3 fm-s53" data-control="{{v.key}}" data-value="{{v.value}}" type="button">{{v.label}}</button></sc-for></div>
